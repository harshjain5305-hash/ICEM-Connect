# ICEM Connect — Environment Configuration Baseline
# Phase 11 Production Deployment (Vercel + Supabase)

# 1. Supabase Backend Configuration
# Obtain from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://placeholder-project.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key

# 2. Institutional Email Domain Validation & Canonical Site URL
# Restricts student registration exclusively to verified ICEM campus emails
VITE_INSTITUTION_EMAIL_DOMAIN=indiraicem.ac.in
VITE_SITE_URL=https://icem-connect.vercel.app/

# 3. Application Metadata
VITE_APP_NAME=ICEM Connect
VITE_APP_VERSION=1.1.0

# Note for Vercel Deployment:
# Add the above 3 variables (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_INSTITUTION_EMAIL_DOMAIN)
# under your Vercel Project Settings -> Environment Variables for Production, Preview, and Development.
